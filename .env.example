# Copy to .env and fill in. Never commit .env.
# Create a "Server-based Applications" client at https://api-console.zoho.in
#   Homepage URL:            http://localhost
#   Authorized Redirect URI: http://localhost:8765/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Data centre of the merchant's Zoho account: in | com | eu | com.au | jp | ca | com.cn | sa
ZOHO_DC=in

# Zoho Inventory plan: sets the daily quota (free=1000 ... premium=10000) and concurrency (free=5, paid=10)
ZOHO_PLAN=free

# Optional tuning (defaults shown)
# ZOHO_CONNECTION=default          # one named connection per merchant org
# ZOHO_REDIRECT_PORT=8765
# ZOHO_RATE_PER_MINUTE=90          # Zoho allows 100/min/org; headroom for the merchant's other apps
# ZOHO_MAX_WAIT_SECONDS=15         # longest an agent call may wait on throttling before RATE_LIMITED
# ZOHO_CACHE_TTL_SECONDS=60
# ZOHO_PII_MODE=masked             # masked | full  (operator decision, never exposed to the model)
# ZOHO_TOKEN_STORE=keyring         # keyring | file
# ZOHO_QUOTA_UTC_OFFSET_MINUTES=330  # day boundary for the daily quota counter (IST)
