    "expect_tools": [{"name": "get_fulfilment_evidence", "args_include": {"reference_number": "order_DemoQ7Hk2pXa01"}}],
    "answer_must_include": ["2849710036514", "Delhivery"]
  },
  {
    "id": "dispute-gap",
    "use_case": "Dispute response",
    "prompt": "How strong is our proof of delivery for order SO-00104 if the customer disputes it?",
    "expect_tools": [{"name": "get_fulfilment_evidence", "args_include": {"salesorder_number": "SO-00104"}}],
    "answer_must_include_any": ["tracking", "AWB"]
  },
  {
    "id": "wismo-in-transit",
    "use_case": "Where is my order",
    "prompt": "Where is order SO-00102? Has it been delivered?",
    "expect_tools": [{"name": "get_fulfilment_evidence"}, {"name": "get_sales_order"}],
    "answer_must_include": ["77501234561"],
    "answer_must_include_any": ["not", "no delivery", "in transit"]
  },
  {
    "id": "cancelled",
    "use_case": "Where is my order",
    "prompt": "Did Razorpay order order_DemoA1bH7jPf06 ship?",
    "expect_tools": [{"name": "get_fulfilment_evidence"}, {"name": "get_sales_order"}, {"name": "search_sales_orders"}],
    "answer_must_include_any": ["cancel", "void"]
  },
  {
    "id": "low-stock",
    "use_case": "Inventory ops",
    "prompt": "Which active products are at or below their reorder level?",
    "expect_tools": [{"name": "list_items", "args_include": {"low_stock_only": true}}],
    "answer_must_include": ["ST-TEE-OLV-M"]
  },
  {
    "id": "customer-orders",
    "use_case": "Customer support",
    "prompt": "Find the orders placed by Meera Nair.",
    "expect_tools": [{"name": "search_sales_orders"}],
