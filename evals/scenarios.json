[
  {
    "id": "cart-oos",
    "use_case": "Abandoned-cart recovery",
    "prompt": "A shopper abandoned a cart with SKUs ST-TEE-OLV-M and ST-TEE-BLK-M (1 each). Which of these can our recovery agent still pitch?",
    "expect_tools": [{"name": "check_availability", "args_include": {"skus": ["ST-TEE-OLV-M", "ST-TEE-BLK-M"]}}],
    "answer_must_include": ["ST-TEE-BLK-M"],
    "answer_must_include_any": ["out of stock", "not available", "unavailable", "0 available"]
  },
  {
    "id": "cart-qty",
    "use_case": "Abandoned-cart recovery",
    "prompt": "Can we promise 5 units of SKU ST-STOLE-PSH to a customer today?",
    "expect_tools": [{"name": "check_availability"}, {"name": "get_item"}],
    "answer_must_include": ["3"]
  },
  {
    "id": "cart-location",
    "use_case": "Abandoned-cart recovery",
    "prompt": "Is the Terracotta Mug (ST-MUG-TERRA) available to ship from our Bengaluru WH warehouse?",
    "expect_tools": [{"name": "check_availability", "args_include": {"location_name": "Bengaluru WH"}}, {"name": "get_item"}],
    "answer_must_include_any": ["Delhi"],
    "answer_must_not_include": ["26 available in Bengaluru"]
  },
  {
